# Vacío: API del mismo origen. Vite redirige únicamente las rutas públicas de demo.
# En producción, configura el reverse proxy o una URL HTTPS real de la API.
VITE_SAAS_API_BASE_URL=
# Solo para dev/preview de Vite; nunca se incluye en el bundle del navegador.
# Para Compose DEV puede usarse http://127.0.0.1:8088.
PRODUCT_API_PROXY_TARGET=http://127.0.0.1:8090

# Origen HTTPS público real, sin ruta, query ni fragmento; vacío en local.
# Activa canonical, hreflang y metadatos para compartir al compilar.
VITE_PUBLIC_SITE_URL=
# Solo tras aprobar dominio, datos legales y despliegue: true permite indexación
# y genera sitemap.xml. Vacío/false mantiene noindex, incluso con URL configurada.
VITE_PUBLIC_INDEXABLE=

# Activa los botones de descarga únicamente cuando existan artefactos públicos,
# firmados y verificados. Déjalos vacíos durante la entrega asistida.
VITE_DOWNLOAD_VENTA_URL=
VITE_DOWNLOAD_VENTA_SHA256_URL=
VITE_DOWNLOAD_GESTION_URL=
VITE_DOWNLOAD_GESTION_SHA256_URL=
VITE_DOWNLOAD_RELEASE_VERSION=
