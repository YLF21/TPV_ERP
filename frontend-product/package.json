{
  "name": "tpv-erp-frontend-product",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -p tsconfig.app.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit --incremental false && vite build --configLoader runner && node scripts/prerender.mjs && node scripts/performance-budget.mjs",
    "preview": "vite preview --configLoader runner",
    "test:contract": "node --experimental-transform-types --test e2e/demo-requests.contract.test.mjs",
    "test:guides": "node --experimental-transform-types --test e2e/application-guides.contract.test.mjs",
    "test:render": "node --test e2e/application-explorer.render.test.mjs",
    "test:a11y": "node --test e2e/marketing-accessibility.test.mjs",
    "test:seo": "node --test e2e/seo.contract.test.mjs",
    "test:campaign": "node --experimental-transform-types --test e2e/marketing-campaign.test.mjs",
    "test:navigation": "node --test e2e/marketing-navigation.test.mjs",
    "test:performance": "node --test e2e/performance-budget.test.mjs",
    "test:images": "node --test e2e/marketing-images.test.mjs",
    "optimize:images": "node scripts/optimize-marketing-images.mjs",
    "check:performance": "node scripts/performance-budget.mjs",
    "test:e2e": "npm run build && node e2e/product-smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright": "1.63.0"
  }
}
