{
  "name": "tpv-erp-frontend-product",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -p tsconfig.app.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit --incremental false && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test:e2e": "npm run build && node e2e/product-smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright": "1.63.0"
  }
}