TPV_SAAS_PORT=8090
TPV_SAAS_DB_URL=jdbc:postgresql://localhost:5433/tpv_erp_saas
TPV_SAAS_DB_USERNAME=tpv_erp_saas
TPV_SAAS_DB_PASSWORD=replace-with-a-strong-database-password
TPV_SAAS_LEGACY_BASIC_AUTH_ENABLED=false
TPV_SAAS_SESSION_LIFETIME=PT8H
TPV_SAAS_CORS_ALLOWED_ORIGINS=
TPV_SAAS_WEB_PORT=8088
TPV_SAAS_FORWARD_HEADERS_STRATEGY=framework
# Clave fija SOLO para el laboratorio local. Sustituyela por una clave aleatoria
# antes de compartir el entorno o desplegarlo fuera de DEV.
TPV_SAAS_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
POSTGRES_DB=tpv_erp_saas
POSTGRES_USER=tpv_erp_saas
POSTGRES_PASSWORD=replace-with-a-strong-database-password
TPV_SAAS_POSTGRES_CPU_LIMIT=1.0
TPV_SAAS_POSTGRES_MEMORY_LIMIT=1g
TPV_SAAS_POSTGRES_PIDS_LIMIT=200
TPV_SAAS_BACKEND_CPU_LIMIT=1.0
TPV_SAAS_BACKEND_MEMORY_LIMIT=768m
TPV_SAAS_BACKEND_PIDS_LIMIT=200
TPV_SAAS_FRONTEND_CPU_LIMIT=0.5
TPV_SAAS_FRONTEND_MEMORY_LIMIT=128m
TPV_SAAS_FRONTEND_PIDS_LIMIT=100
TPV_SAAS_LOG_MAX_SIZE=10m
TPV_SAAS_LOG_MAX_FILES=3
