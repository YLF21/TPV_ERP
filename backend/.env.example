SPRING_PROFILES_ACTIVE=dev
TPV_DB_URL=jdbc:postgresql://localhost:5432/tpv_erp_dev
TPV_DB_USERNAME=tpv_erp
TPV_DB_PASSWORD=change-me
TPV_TEST_DB_URL=jdbc:postgresql://localhost:5432/tpv_erp_test
TPV_TEST_DB_USERNAME=tpv_erp_test
TPV_TEST_DB_PASSWORD=change-me
# Alternativa historica para pruebas PostgreSQL (usar una sola familia):
# TPV_ERP_TEST_DB_URL=jdbc:postgresql://localhost:5432/tpv_erp_test
# TPV_ERP_TEST_DB_USER=tpv_erp_test
# TPV_ERP_TEST_DB_PASSWORD=change-me
TPV_SERVER_ADDRESS=127.0.0.1
TPV_SERVER_PORT=8080
TPV_KEY_DIRECTORY=C:/ProgramData/TPV-ERP/keys
TPV_BACKUP_DIRECTORY=D:/TPV-ERP-Backups
TPV_LICENSE_ISSUER_PUBLIC_KEY_FILE=C:/ProgramData/TPV-ERP/license-issuer-public.pem
# Obligatoria con el perfil prod. Debe ser la raiz HTTPS real del SaaS, sin ruta.
TPV_LICENSE_SAAS_URL=https://licenses.your-domain.invalid
# Opcional si sincronizacion y licencias comparten gateway; si se omite, prod usa la URL anterior.
# TPV_SYNC_CENTRAL_URL=https://licenses.your-domain.invalid
TPV_SYNC_WORKER_ENABLED=true
# AEAT TEST real (preproduccion): no mezclar con las variables PRODUCTION.
TPV_VERIFACTU_RUNTIME_CLASS=REAL
TPV_VERIFACTU_ENDPOINT_MODE=TEST
TPV_VERIFACTU_ENDPOINT_ENVIRONMENT=TEST
TPV_VERIFACTU_TRANSPORT_MODE=AEAT
TPV_VERIFACTU_AEAT_TEST_NETWORK_ENABLED=true
TPV_VERIFACTU_PRODUCTION_ENABLED=false
TPV_VERIFACTU_WORKER_ENABLED=false
# Solo para el despliegue fiscal final autorizado:
# TPV_VERIFACTU_ENDPOINT_MODE=PRODUCTION
# TPV_VERIFACTU_ENDPOINT_ENVIRONMENT=PRODUCTION
# TPV_VERIFACTU_AEAT_TEST_NETWORK_ENABLED=false
# TPV_VERIFACTU_PRODUCTION_ENABLED=true
# TPV_VERIFACTU_PRODUCER_NAME=Productor Fiscal S.L.
# TPV_VERIFACTU_PRODUCER_TAX_ID=B12345674
# TPV_VERIFACTU_SYSTEM_NAME=TPV ERP
# TPV_VERIFACTU_SYSTEM_ID=01
# TPV_VERIFACTU_SYSTEM_VERSION=4.1.0
# TPV_VERIFACTU_DECLARATION_HASH=<SHA-256 hexadecimal de la declaracion responsable>
# TPV_VERIFACTU_WORKER_ENABLED=true
TPV_PG_DUMP_COMMAND=pg_dump
TPV_PG_RESTORE_COMMAND=pg_restore
TPV_VERIFACTU_EXPORT_JOB_DIRECTORY=
TPV_VERIFACTU_EXPORT_JOB_SINGLE_INSTANCE=true
TPV_VERIFACTU_EXPORT_JOB_MAX_RECORDS=1000000
TPV_VERIFACTU_EXPORT_JOB_MAX_XML_BYTES=2000000000
# Puente localhost para SDKs de datafono presenciales. No use una IP remota.
# TPV_PAYMENT_BRIDGE_URL=http://127.0.0.1:9123
# TPV_PAYMENT_BRIDGE_TOKEN=replace-with-a-long-random-local-token
