<!-- Justificante de cobro de un documento pendiente para impresora termica de 80 mm. -->
<!-- JasperReports/Jaspersoft Studio 7.0.6. Parametros: DOCUMENTO_ID y PAGO_ID. -->
<jasperReport name="cobro_pendiente" language="java" columnCount="1" pageWidth="227" pageHeight="842" columnWidth="207" leftMargin="10" rightMargin="10" topMargin="5" bottomMargin="5" uuid="ad5bd189-8c89-4638-865f-635637caf794" ignorePagination="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TPV ERP PostgreSQL"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<style name="Texto" fontName="DejaVu Sans" fontSize="8.0"/>
	<style name="Centrado" style="Texto" hTextAlign="Center"/>
	<style name="Derecha" style="Texto" hTextAlign="Right"/>
	<style name="BarcodeCentrado" hImageAlign="Center" vImageAlign="Middle"/>
	<parameter name="DOCUMENTO_ID" class="java.lang.String">
		<description><![CDATA[UUID del albaran, factura o ticket con saldo pendiente.]]></description>
	</parameter>
	<parameter name="PAGO_ID" class="java.lang.String">
		<description><![CDATA[UUID interno del pago o su request_id idempotente.]]></description>
	</parameter>
	<query language="sql"><![CDATA[
WITH pago_objetivo AS (
    SELECT dp.*
    FROM documento_pago dp
    WHERE dp.documento_id = CAST($P{DOCUMENTO_ID} AS uuid)
      AND (dp.id = CAST($P{PAGO_ID} AS uuid)
           OR dp.request_id = CAST($P{PAGO_ID} AS uuid))
    ORDER BY CASE WHEN dp.request_id = CAST($P{PAGO_ID} AS uuid) THEN 0 ELSE 1 END
    LIMIT 1
)
SELECT
    CASE
        WHEN COALESCE(cdi.mostrar_nombre_tienda, TRUE)
            THEN COALESCE(NULLIF(TRIM(t.nombre), ''), NULLIF(TRIM(e.razon_social), ''))
        ELSE COALESCE(NULLIF(TRIM(e.razon_social), ''), NULLIF(TRIM(t.nombre), ''))
    END AS nombre_cabecera,
    CASE
        WHEN COALESCE(cdi.mostrar_nombre_tienda, TRUE)
            THEN NULLIF(TRIM(e.razon_social), '')
        ELSE NULL
    END AS nombre_empresa_secundario,
    t.telefono,
    t.email,
    jsonb_extract_path_text(t.direccion, 'linea1') AS direccion,
    jsonb_extract_path_text(t.direccion, 'codigoPostal') AS codigo_postal,
    jsonb_extract_path_text(t.direccion, 'ciudad') AS ciudad,
    jsonb_extract_path_text(t.direccion, 'pais') AS pais,
    e.tax_id AS cif,
    ldt.contenido AS logo_contenido,
    d.numero AS numero_documento,
    CAST(COALESCE(po.request_id, po.id) AS varchar) AS numero_cobro,
    po.creado_en AS fecha_cobro,
    COALESCE(NULLIF(TRIM(term.nombre), ''), '—') AS terminal,
    COALESCE(NULLIF(TRIM(c.nombre_fiscal), ''), '—') AS cliente,
    c.client_id AS codigo_cliente,
    c.numero_documento AS documento_cliente,
    UPPER(REPLACE(COALESCE(NULLIF(TRIM(mp.nombre), ''), 'PAGO'), '_', ' ')) AS metodo_pago,
    po.importe AS importe_cobrado,
    COALESCE(NULLIF(TRIM(po.referencia), ''), NULLIF(TRIM(po.autorizacion_tarjeta), ''),
             NULLIF(TRIM(po.codigo_vale), '')) AS referencia,
    po.fecha_transferencia,
    GREATEST(
        d.total - COALESCE((
            SELECT SUM(anterior.importe)
            FROM documento_pago anterior
            WHERE anterior.documento_id = d.id
              AND (
                    anterior.posicion < po.posicion
                 OR (anterior.posicion = po.posicion AND anterior.creado_en < po.creado_en)
                 OR (anterior.posicion = po.posicion AND anterior.creado_en = po.creado_en
                     AND anterior.id <= po.id)
              )
        ), 0::numeric),
        0::numeric
    ) AS saldo_pendiente
FROM pago_objetivo po
INNER JOIN documento d ON d.id = po.documento_id
INNER JOIN tienda t ON t.id = d.tienda_id
INNER JOIN empresa e ON e.id = t.empresa_id
INNER JOIN cliente c ON c.id = d.cliente_id
INNER JOIN metodo_pago mp ON mp.id = po.metodo_pago_id
LEFT JOIN configuracion_documento_impreso_tienda cdi ON cdi.tienda_id = t.id
LEFT JOIN logo_documento_tienda ldt ON ldt.id = cdi.logo_id AND ldt.tienda_id = t.id
LEFT JOIN LATERAL (
    SELECT evento.terminal_id
    FROM documento_evento_operativo evento
    WHERE evento.documento_id = d.id
      AND evento.tipo = 'COBRADO'
    ORDER BY ABS(EXTRACT(EPOCH FROM (evento.ocurrido_en - po.creado_en))), evento.id
    LIMIT 1
) evento_cobro ON TRUE
LEFT JOIN terminal term
    ON term.id = COALESCE(evento_cobro.terminal_id, d.terminal_origen_id)
   AND term.tienda_id = d.tienda_id
WHERE d.id = CAST($P{DOCUMENTO_ID} AS uuid)
  AND d.tipo IN ('ALBARAN_VENTA', 'FACTURA_VENTA', 'TICKET')
  AND (d.tipo <> 'TICKET' OR d.cuenta_cobrar = TRUE)
  AND d.estado NOT IN ('BORRADOR', 'ANULADO')
]]></query>
