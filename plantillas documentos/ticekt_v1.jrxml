			<expression><![CDATA[$F{nombre_cliente} == null ? "" : $F{nombre_cliente}.trim()]]></expression>
		</element>
		<element kind="textField" uuid="f6ba42cc-f6f9-4724-99c7-c1ef05017c2d" x="3" y="210" width="201" height="12" fontSize="8.0" textAdjust="ScaleFont" removeLineWhenBlank="true" hTextAlign="Center">
			<expression><![CDATA[($F{codigo_cliente} == null || $F{codigo_cliente}.trim().isEmpty() ? "" : "Cód.: " + $F{codigo_cliente}.trim()) + ($F{telefono_cliente} == null || $F{telefono_cliente}.trim().isEmpty() ? "" : " · Tel.: " + $F{telefono_cliente}.trim()) ]]></expression>
		</element>
		<element kind="textField" uuid="d9265e60-49d7-409c-b9bf-bd47a6fe4df2" x="3" y="223" width="201" height="12" fontSize="8.0" removeLineWhenBlank="true" hTextAlign="Center">
			<printWhenExpression><![CDATA[$F{porcentaje_descuento_cliente} != null && $F{porcentaje_descuento_cliente}.compareTo(java.math.BigDecimal.ZERO) > 0]]></printWhenExpression>
			<expression><![CDATA["Descuento de miembro: " + new java.text.DecimalFormat("#,##0.##").format($F{porcentaje_descuento_cliente}) + "%"]]></expression>
		</element>
		<element kind="staticText" uuid="842215b5-327b-49d8-b601-f723784ad82f" x="3" y="241" width="201" height="12" fontSize="8.0" bold="true" hTextAlign="Center">
			<printWhenExpression><![CDATA[($F{usuario_nombre} != null && !$F{usuario_nombre}.trim().isEmpty()) || ($F{terminal_nombre} != null && !$F{terminal_nombre}.trim().isEmpty())]]></printWhenExpression>
			<text><![CDATA[ATENDIDO POR]]></text>
		</element>
		<element kind="textField" uuid="de28df7a-5ca3-4586-b2ee-f714ce8f953f" x="3" y="254" width="201" height="12" fontSize="8.0" removeLineWhenBlank="true" hTextAlign="Center">
			<expression><![CDATA[($F{usuario_nombre} == null ? "" : $F{usuario_nombre}.trim())
+ ($F{terminal_nombre} == null || $F{terminal_nombre}.trim().isEmpty()
    ? ""
    : (($F{usuario_nombre} == null || $F{usuario_nombre}.trim().isEmpty()) ? "" : " · ") + "Terminal: " + $F{terminal_nombre}.trim())]]></expression>
		</element>
