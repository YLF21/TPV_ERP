	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TPV ERP PostgreSQL"/>
	<parameter name="TIENDA_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["13b6fb74-3de0-3198-8166-cf4eeb249f7f"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOCUMENTO_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["04e5bdfb-4f14-3e39-a9cd-b9fa291461d9"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[WITH cabecera AS (
    SELECT
        d.id AS documento_id,
        CASE WHEN fiscal.registro_id IS NULL
             THEN COALESCE(NULLIF(TRIM(e.razon_social), ''), t.nombre)
             ELSE fiscal.obligado_nombre END AS nombre_cabecera,
        CASE WHEN fiscal.registro_id IS NULL THEN e.tax_id
             ELSE fiscal.obligado_nif END AS cif,
        CASE WHEN fiscal.registro_id IS NULL THEN t.telefono
             ELSE fiscal.obligado_direccion ->> 'telefono' END AS telefono,
        CASE WHEN fiscal.registro_id IS NULL THEN t.email
             ELSE fiscal.obligado_direccion ->> 'email' END AS email,
        CASE WHEN fiscal.registro_id IS NULL THEN jsonb_extract_path_text(t.direccion, 'linea1')
             ELSE fiscal.obligado_direccion ->> 'linea1' END AS direccion,
        CASE WHEN fiscal.registro_id IS NULL THEN jsonb_extract_path_text(t.direccion, 'codigoPostal')
             ELSE fiscal.obligado_direccion ->> 'codigoPostal' END AS codigo_postal,
        CASE WHEN fiscal.registro_id IS NULL THEN jsonb_extract_path_text(t.direccion, 'ciudad')
             ELSE fiscal.obligado_direccion ->> 'ciudad' END AS ciudad,
        CASE WHEN fiscal.registro_id IS NULL THEN jsonb_extract_path_text(t.direccion, 'provincia')
             ELSE fiscal.obligado_direccion ->> 'provincia' END AS provincia,
        CASE WHEN fiscal.registro_id IS NULL THEN jsonb_extract_path_text(t.direccion, 'pais')
             ELSE fiscal.obligado_direccion ->> 'pais' END AS pais,
        d.numero AS numero_ticket,
        COALESCE(d.confirmado_en, d.creado_en) AS fecha_ticket,
        d.total AS total_ticket,
        ldt.contenido AS logo_contenido,
        COALESCE(fiscal.qr_url, '') AS contenido_qr,
        fiscal.qr_prefijo,
        fiscal.qr_leyenda,
        fiscal.aviso_pruebas,
        COALESCE(cdi.observaciones_ticket, '') AS observacion_ticket,
        c.nombre_fiscal AS nombre_cliente,
        c.client_id AS codigo_cliente,
        c.telefono AS telefono_cliente,
        c.tarifa,
        c.descuento AS porcentaje_descuento_cliente,
        COALESCE(NULLIF(TRIM(u.user_name), ''), NULLIF(TRIM(u.nombre), '')) AS usuario_nombre,
        NULLIF(TRIM(term.nombre), '') AS terminal_nombre
    FROM documento d
    INNER JOIN tienda t ON t.id = d.tienda_id
    INNER JOIN empresa e ON e.id = t.empresa_id
    LEFT JOIN LATERAL (
        SELECT rf.id AS registro_id,
               arf.obligado_nombre, arf.obligado_nif, arf.obligado_direccion,
               sif.qr_url, sif.qr_prefijo, sif.qr_leyenda, sif.aviso_pruebas
          FROM registro_fiscal rf
          INNER JOIN artefacto_registro_fiscal arf ON arf.registro_id = rf.id
          INNER JOIN snapshot_impresion_fiscal sif ON sif.registro_id = rf.id
         WHERE rf.documento_id = d.id
           AND rf.operacion = 'ALTA'
         ORDER BY rf.secuencia DESC
         LIMIT 1
    ) fiscal ON TRUE
    LEFT JOIN cliente c ON c.id = d.cliente_id
    LEFT JOIN usuario u ON u.id = COALESCE(d.confirmado_por, d.creado_por)
        AND u.tienda_id = d.tienda_id
    LEFT JOIN terminal term ON term.id = d.terminal_origen_id
        AND term.tienda_id = d.tienda_id
    LEFT JOIN configuracion_documento_impreso_tienda cdi ON cdi.tienda_id = t.id
    LEFT JOIN logo_documento_tienda ldt ON ldt.id = cdi.logo_id AND ldt.tienda_id = t.id
    WHERE d.id = CAST($P{DOCUMENTO_ID} AS uuid)
      AND t.id = CAST($P{TIENDA_ID} AS uuid)
),
lineas AS (
    SELECT
        dl.documento_id,
        dl.posicion,
        dl.nombre AS articulo,
        dl.cantidad,
        dl.precio_unitario AS precio,
        COALESCE(dl.descuento, 0::numeric) AS descuento_linea,
        dl.precio_unitario * dl.cantidad AS importe_bruto,
        GREATEST(dl.precio_unitario * dl.cantidad - dl.total, 0::numeric) AS importe_descuento,
        dl.total AS total_linea
    FROM documento_linea dl
    WHERE dl.documento_id = CAST($P{DOCUMENTO_ID} AS uuid)
      AND dl.tipo_linea NOT IN ('MANUAL_DISCOUNT', 'PROMOTIONAL_COUPON')
),
totales AS (
    SELECT
        c.documento_id,
        COALESCE(SUM(l.importe_bruto), 0::numeric) AS subtotal_bruto,
        GREATEST(COALESCE(SUM(l.importe_bruto), 0::numeric) - c.total_ticket, 0::numeric) AS descuento_total
    FROM cabecera c
    LEFT JOIN lineas l ON l.documento_id = c.documento_id
    GROUP BY c.documento_id, c.total_ticket
),
pago_origen AS (
    SELECT
        dp.documento_id,
        dp.posicion,
        COALESCE(mp.nombre, 'PAGO') AS metodo_pago,
        dp.importe,
        dp.entregado,
        dp.cambio,
        COALESCE(NULLIF(dp.autorizacion_tarjeta, ''), NULLIF(op.authorization_code, '')) AS autorizacion,
        receipt.receipt_text
    FROM documento_pago dp
    LEFT JOIN metodo_pago mp ON mp.id = dp.metodo_pago_id
    LEFT JOIN LATERAL (
        SELECT pto.*
        FROM payment_terminal_operation pto
        WHERE pto.id = dp.terminal_cobro_id OR pto.document_payment_id = dp.id
        ORDER BY pto.created_at DESC
        LIMIT 1
    ) op ON TRUE
    LEFT JOIN LATERAL (
        SELECT ptr.receipt_text
        FROM payment_terminal_receipt ptr
        WHERE ptr.operation_id = op.id
        ORDER BY ptr.updated_at DESC
        LIMIT 1
    ) receipt ON TRUE
    WHERE dp.documento_id = CAST($P{DOCUMENTO_ID} AS uuid)
),
pago_filas AS (
    SELECT documento_id, posicion * 10 AS orden, metodo_pago AS etiqueta, importe AS importe FROM pago_origen
    UNION ALL
    SELECT documento_id, posicion * 10 + 1, 'Entregado', entregado FROM pago_origen WHERE entregado IS NOT NULL
    UNION ALL
    SELECT documento_id, posicion * 10 + 2, 'Cambio entregado', cambio FROM pago_origen WHERE cambio IS NOT NULL
    UNION ALL
    SELECT documento_id, posicion * 10 + 3, 'Autorización: ' || autorizacion, NULL::numeric FROM pago_origen WHERE autorizacion IS NOT NULL
    UNION ALL
    SELECT documento_id, posicion * 10 + 4, receipt_text, NULL::numeric FROM pago_origen WHERE receipt_text IS NOT NULL
),
pagos AS (
    SELECT
        documento_id,
        string_agg(etiqueta, E'\n' ORDER BY orden) AS pago_etiquetas,
        string_agg(CASE WHEN importe IS NULL THEN '' ELSE translate(to_char(importe, 'FM999999990.00'), '.', ',') || ' €' END, E'\n' ORDER BY orden) AS pago_importes
    FROM pago_filas
    GROUP BY documento_id
),
lineas_fiscales AS (
    SELECT
        dl.documento_id,
        dl.porcentaje_impuesto,
        dl.base,
        dl.impuesto,
        COALESCE(NULLIF(dl.regimen_impuesto, ''), licencia_actual.regimen_impuesto, 'IVA') AS regimen_impuesto,
        ((COALESCE(UPPER(licencia_actual.perfil_comercial), '') = 'MINORISTA'
          OR COALESCE(d.comentario_interno, '') ILIKE '%comerciante minorista%')
          AND COALESCE(NULLIF(dl.regimen_impuesto, ''), licencia_actual.regimen_impuesto, 'IVA') = 'IGIC') AS impuesto_exento
    FROM documento_linea dl
    INNER JOIN documento d ON d.id = dl.documento_id
    LEFT JOIN LATERAL (
        SELECT l.regimen_impuesto, l.perfil_comercial
        FROM licencia l
        WHERE l.tienda_id = d.tienda_id AND l.activa = TRUE
        ORDER BY l.valida_desde DESC NULLS LAST, l.importada_en DESC NULLS LAST
        LIMIT 1
    ) licencia_actual ON TRUE
    WHERE dl.documento_id = CAST($P{DOCUMENTO_ID} AS uuid)
),
impuesto_agrupado AS (
    SELECT
        documento_id,
        CASE WHEN impuesto_exento THEN NULL ELSE porcentaje_impuesto END AS porcentaje_iva,
        SUM(base) AS base_iva,
        SUM(impuesto) AS cuota_iva,
        regimen_impuesto,
        impuesto_exento
    FROM lineas_fiscales
    WHERE porcentaje_impuesto IS NOT NULL OR impuesto_exento
    GROUP BY documento_id, regimen_impuesto, impuesto_exento,
             CASE WHEN impuesto_exento THEN NULL ELSE porcentaje_impuesto END
),
impuesto_filas AS (
    SELECT
        documento_id,
        CASE
            WHEN impuesto_exento THEN regimen_impuesto || ' EXENTO'
            ELSE regimen_impuesto || ' ' || translate(to_char(porcentaje_iva, 'FM999990.##'), '.', ',') || '%'
        END AS impuesto_nombre,
        base_iva,
        cuota_iva,
        CASE WHEN impuesto_exento THEN -1::numeric ELSE porcentaje_iva END AS orden
    FROM impuesto_agrupado
),
impuestos AS (
    SELECT
        documento_id,
        string_agg(impuesto_nombre, E'\n' ORDER BY orden) AS impuesto_nombres,
        string_agg(translate(to_char(base_iva, 'FM999999990.00'), '.', ',') || ' €', E'\n' ORDER BY orden) AS impuesto_bases,
        string_agg(translate(to_char(cuota_iva, 'FM999999990.00'), '.', ',') || ' €', E'\n' ORDER BY orden) AS impuesto_cuotas
    FROM impuesto_filas
    GROUP BY documento_id
)
SELECT
    c.nombre_cabecera, c.cif, c.telefono, c.email, c.direccion, c.codigo_postal, c.ciudad, c.provincia, c.pais,
    c.numero_ticket, c.fecha_ticket, c.total_ticket, c.logo_contenido, c.contenido_qr,
    c.qr_prefijo, c.qr_leyenda, c.aviso_pruebas, c.observacion_ticket,
    c.nombre_cliente, c.codigo_cliente, c.telefono_cliente, c.tarifa, c.porcentaje_descuento_cliente,
    c.usuario_nombre, c.terminal_nombre,
    l.posicion, l.articulo, l.cantidad, l.precio, l.descuento_linea, l.importe_bruto, l.importe_descuento, l.total_linea,
    t.subtotal_bruto, t.descuento_total,
    p.pago_etiquetas, p.pago_importes,
    i.impuesto_nombres, i.impuesto_bases, i.impuesto_cuotas
FROM cabecera c
LEFT JOIN lineas l ON l.documento_id = c.documento_id
LEFT JOIN totales t ON t.documento_id = c.documento_id
LEFT JOIN pagos p ON p.documento_id = c.documento_id
LEFT JOIN impuestos i ON i.documento_id = c.documento_id
ORDER BY l.posicion NULLS LAST]]></query>
