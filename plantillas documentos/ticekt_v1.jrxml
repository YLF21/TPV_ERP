<jasperReport name="ticekt_v1" language="java" columnCount="1" pageWidth="227" pageHeight="842" columnWidth="207" leftMargin="10" rightMargin="10" topMargin="5" bottomMargin="5" uuid="72e5b760-6648-49ab-8325-acde62b8ce51" ignorePagination="true">
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
