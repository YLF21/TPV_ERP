<!-- Plantilla de comprobante de anulacion para ticket termico de 80 mm. -->
<!-- JasperReports/Jaspersoft Studio 7.0.6. Parametro requerido: DOCUMENTO_ID. -->
<jasperReport name="ticket_anulado" language="java" columnCount="1" pageWidth="227" pageHeight="842" columnWidth="207" leftMargin="10" rightMargin="10" topMargin="5" bottomMargin="5" uuid="5fa837cc-6ef4-43b8-92ff-f4808772ca9e" ignorePagination="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TPV ERP PostgreSQL"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<style name="Texto" fontName="DejaVu Sans" fontSize="8.0"/>
	<style name="Centrado" style="Texto" hTextAlign="Center"/>
	<style name="Derecha" style="Texto" hTextAlign="Right"/>
	<style name="BarcodeCentrado" hImageAlign="Center" vImageAlign="Middle"/>
	<parameter name="DOCUMENTO_ID" class="java.lang.String">
		<description><![CDATA[UUID del ticket original, que debe encontrarse en estado ANULADO.]]></description>
	</parameter>
	<query language="sql"><![CDATA[
SELECT
    CASE
        WHEN COALESCE(cdi.mostrar_nombre_tienda, TRUE)
            THEN COALESCE(NULLIF(TRIM(t.nombre), ''), NULLIF(TRIM(e.razon_social), ''))
        ELSE COALESCE(NULLIF(TRIM(e.razon_social), ''), NULLIF(TRIM(t.nombre), ''))
    END AS tienda,
    CASE
        WHEN COALESCE(cdi.mostrar_nombre_tienda, TRUE)
            THEN NULLIF(TRIM(e.razon_social), '')
        ELSE NULL
    END AS razon_social,
    t.telefono,
    t.email,
    e.tax_id AS nif,
    CONCAT_WS(' · ',
        NULLIF(TRIM(jsonb_extract_path_text(t.direccion, 'linea1')), ''),
        NULLIF(TRIM(CONCAT_WS(' ',
            jsonb_extract_path_text(t.direccion, 'codigoPostal'),
            jsonb_extract_path_text(t.direccion, 'ciudad'))), '')
    ) AS direccion_tienda,
    ldt.contenido AS logo_contenido,
    d.numero AS numero_ticket,
    COALESCE(d.confirmado_en, d.creado_en) AS fecha_original,
    d.anulado_en AS fecha_anulacion,
    COALESCE(NULLIF(TRIM(op.motivo), ''), NULLIF(TRIM(d.motivo_anulacion), ''), 'Sin motivo indicado') AS motivo,
    COALESCE(NULLIF(TRIM(uop.user_name), ''), NULLIF(TRIM(uop.nombre), ''), '—') AS operador,
    COALESCE(NULLIF(TRIM(uau.user_name), ''), NULLIF(TRIM(uau.nombre), ''), '—') AS autorizador,
    COALESCE(NULLIF(TRIM(term.nombre), ''), '—') AS terminal,
    d.total AS total_anulado,
    COALESCE(pagos.resumen, 'Sin información de pago') AS resumen_pagos,
    dl.posicion,
    NULLIF(TRIM(dl.codigo), '') AS codigo_articulo,
    dl.nombre AS articulo,
    dl.cantidad,
    dl.precio_unitario AS precio_unitario,
    dl.total AS total_linea,
    series.numeros_serie
FROM documento d
INNER JOIN tienda t ON t.id = d.tienda_id
INNER JOIN empresa e ON e.id = t.empresa_id
LEFT JOIN configuracion_documento_impreso_tienda cdi ON cdi.tienda_id = t.id
LEFT JOIN logo_documento_tienda ldt ON ldt.id = cdi.logo_id AND ldt.tienda_id = t.id
LEFT JOIN LATERAL (
    SELECT tao.*
    FROM ticket_anulacion_operacion tao
    WHERE tao.ticket_id = d.id
      AND tao.estado = 'COMPLETED'
    ORDER BY tao.completado_en DESC NULLS LAST, tao.creado_en DESC
    LIMIT 1
) op ON TRUE
LEFT JOIN usuario uop ON uop.id = COALESCE(op.operador_usuario_id, d.anulado_por)
LEFT JOIN usuario uau ON uau.id = COALESCE(op.autorizador_usuario_id, d.anulado_por)
LEFT JOIN terminal term ON term.id = COALESCE(op.terminal_id, d.terminal_origen_id)
LEFT JOIN LATERAL (
    SELECT string_agg(
        UPPER(REPLACE(COALESCE(NULLIF(TRIM(mp.nombre), ''), 'PAGO'), '_', ' '))
        || ': ' || TO_CHAR(dp.importe, 'FM999999990.00') || ' €'
        || CASE
            WHEN COALESCE(
                NULLIF(op.compensaciones_manuales ->> CAST(dp.id AS text), ''),
                NULLIF(dp.referencia, ''),
                NULLIF(dp.autorizacion_tarjeta, ''),
                NULLIF(dp.codigo_vale, '')
            ) IS NULL THEN ''
            ELSE '  Ref. ' || COALESCE(
                NULLIF(op.compensaciones_manuales ->> CAST(dp.id AS text), ''),
                NULLIF(dp.referencia, ''),
                NULLIF(dp.autorizacion_tarjeta, ''),
                NULLIF(dp.codigo_vale, '')
            )
        END,
        E'\n' ORDER BY dp.posicion, dp.creado_en
    ) AS resumen
    FROM documento_pago dp
    LEFT JOIN metodo_pago mp ON mp.id = dp.metodo_pago_id
    WHERE dp.documento_id = d.id
) pagos ON TRUE
LEFT JOIN documento_linea dl
    ON dl.documento_id = d.id
   AND dl.tipo_linea NOT IN ('MANUAL_DISCOUNT', 'PROMOTIONAL_COUPON')
LEFT JOIN LATERAL (
    SELECT string_agg(dlns.numero_serie, ', ' ORDER BY dlns.posicion) AS numeros_serie
    FROM documento_linea_numero_serie dlns
    WHERE dlns.documento_linea_id = dl.id
) series ON TRUE
WHERE d.id = CAST($P{DOCUMENTO_ID} AS uuid)
  AND d.tipo = 'TICKET'
  AND d.estado = 'ANULADO'
ORDER BY dl.posicion NULLS LAST
]]></query>
