	<parameter name="TIENDA_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["13b6fb74-3de0-3198-8166-cf4eeb249f7f"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOCUMENTO_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["58109209-2548-4c19-9c4e-6f47c541035b"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT
    COALESCE((SELECT sif.qr_url
        FROM snapshot_impresion_fiscal sif
        INNER JOIN registro_fiscal rf ON rf.id = sif.registro_id
        WHERE rf.documento_id = d.id AND rf.operacion = 'ALTA'
        ORDER BY rf.secuencia DESC LIMIT 1), '') AS contenido_qr,
    COALESCE(
        cdi.observaciones_ticket,
        ''
    ) AS observacion_ticket,
    COALESCE(NULLIF(TRIM(u.user_name), ''), NULLIF(TRIM(u.nombre), '')) AS usuario_nombre,
    NULLIF(TRIM(term.nombre), '') AS terminal_nombre
FROM documento d
LEFT JOIN configuracion_documento_impreso_tienda cdi
    ON cdi.tienda_id = d.tienda_id
LEFT JOIN usuario u
    ON u.id = COALESCE(d.confirmado_por, d.creado_por)
   AND u.tienda_id = d.tienda_id
LEFT JOIN terminal term
    ON term.id = d.terminal_origen_id
   AND term.tienda_id = d.tienda_id
WHERE d.id = CAST($P{DOCUMENTO_ID} AS uuid)]]></query>
	<field name="contenido_qr" class="java.lang.String">
