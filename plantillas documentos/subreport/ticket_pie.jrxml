<jasperReport name="ticket_pie" language="java" columnCount="1" pageWidth="207" pageHeight="842" orientation="Landscape" columnWidth="207" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="b83b7c92-857f-4afb-a105-391a9fd343f8">
