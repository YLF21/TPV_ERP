<jasperReport name="ticket_impuesto_compacta" language="java" columnCount="1" pageWidth="207" pageHeight="842" orientation="Landscape" columnWidth="207" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a7e38e2a-1b57-4e83-b8cb-bd2e5b806104">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="TPV ERP PostgreSQL"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<parameter name="DOCUMENTO_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["58109209-2548-4c19-9c4e-6f47c541035b"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[WITH lineas_fiscales AS (
    SELECT
        dl.porcentaje_impuesto,
        dl.base,
        dl.impuesto,
        COALESCE(NULLIF(dl.regimen_impuesto, ''), licencia_actual.regimen_impuesto, 'IVA') AS regimen_impuesto,
        (
            COALESCE(UPPER(licencia_actual.perfil_comercial), '') = 'MINORISTA'
            OR COALESCE(d.comentario_interno, '') ILIKE '%comerciante minorista%'
        )
            AND COALESCE(NULLIF(dl.regimen_impuesto, ''), licencia_actual.regimen_impuesto, 'IVA') = 'IGIC'
            AS impuesto_exento
    FROM documento_linea dl
    INNER JOIN documento d
        ON d.id = dl.documento_id
    LEFT JOIN LATERAL (
        SELECT l.regimen_impuesto, l.perfil_comercial
        FROM licencia l
        WHERE l.tienda_id = d.tienda_id
          AND l.activa = TRUE
        ORDER BY l.valida_desde DESC NULLS LAST, l.importada_en DESC NULLS LAST
        LIMIT 1
    ) licencia_actual ON TRUE
    WHERE dl.documento_id = CAST($P{DOCUMENTO_ID} AS uuid)
      AND dl.tipo_linea <> 'MANUAL_DISCOUNT'
)
SELECT
    CASE WHEN impuesto_exento THEN NULL ELSE porcentaje_impuesto END AS porcentaje_iva,
    SUM(base) AS base_iva,
    SUM(impuesto) AS importe_iva,
    regimen_impuesto,
    impuesto_exento
FROM lineas_fiscales
WHERE porcentaje_impuesto IS NOT NULL
   OR impuesto_exento
GROUP BY regimen_impuesto, impuesto_exento,
    CASE WHEN impuesto_exento THEN NULL ELSE porcentaje_impuesto END
ORDER BY porcentaje_iva NULLS FIRST]]></query>
