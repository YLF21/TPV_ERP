<jasperReport name="ticket_pie_minimalista" language="java" columnCount="1" pageWidth="207" pageHeight="842" orientation="Landscape" columnWidth="207" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a7e38e2a-1b57-4e83-b8cb-bd2e5b806106">
