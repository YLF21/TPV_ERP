	<parameter name="DOCUMENTO_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["58109209-2548-4c19-9c4e-6f47c541035b"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT
    dl.posicion,
    dl.nombre AS articulo,
    dl.cantidad,
    dl.precio_unitario AS precio,
    dl.descuento AS descuento_linea,
    dl.precio_unitario * dl.cantidad AS importe_bruto,
    dl.precio_unitario * dl.cantidad - dl.total AS importe_descuento,
    dl.total AS total_linea,
    d.descuento_global,
    vale.concepto_vale,
    vale.codigo_vale,
    COALESCE(vale.importe_descuento_vale, 0::numeric) AS importe_descuento_vale,
    GREATEST(
        SUM(dl.total) OVER () - d.total,
        0::numeric
    ) +
    CASE
        WHEN COALESCE(c.descuento, 0) > 0
         AND d.descuento_global <> c.descuento
         AND NOT EXISTS (
             SELECT 1
             FROM documento_linea dcl
             WHERE dcl.documento_id = d.id
               AND dcl.descuento = c.descuento
               AND dcl.promocion_id IS NULL
               AND dcl.cupon_promocional_id IS NULL
         )
        THEN ROUND(d.total * c.descuento / 100, 2)
        ELSE 0::numeric
    END AS importe_descuento_ticket,
    c.descuento AS porcentaje_descuento_socio,
    CASE
        WHEN COALESCE(c.descuento, 0) > 0
         AND d.descuento_global <> c.descuento
         AND NOT EXISTS (
             SELECT 1
             FROM documento_linea dcl
             WHERE dcl.documento_id = d.id
               AND dcl.descuento = c.descuento
               AND dcl.promocion_id IS NULL
               AND dcl.cupon_promocional_id IS NULL
         )
        THEN ROUND(d.total * c.descuento / 100, 2)
        ELSE 0::numeric
    END AS importe_descuento_socio,
    d.total -
    CASE
        WHEN COALESCE(c.descuento, 0) > 0
         AND d.descuento_global <> c.descuento
         AND NOT EXISTS (
             SELECT 1
             FROM documento_linea dcl
             WHERE dcl.documento_id = d.id
               AND dcl.descuento = c.descuento
               AND dcl.promocion_id IS NULL
               AND dcl.cupon_promocional_id IS NULL
         )
        THEN ROUND(d.total * c.descuento / 100, 2)
        ELSE 0::numeric
    END AS total_ticket
FROM documento_linea dl
INNER JOIN documento d
    ON d.id = dl.documento_id
LEFT JOIN cliente c
    ON c.id = d.cliente_id
LEFT JOIN LATERAL (
    SELECT
        string_agg(
            COALESCE(NULLIF(vl.nombre, ''), NULLIF(p.nombre, ''), 'DTO. VALE'),
            ', ' ORDER BY vl.posicion
        ) AS concepto_vale,
        string_agg(
            COALESCE(
                NULLIF(vl.codigo, ''),
                CASE
                    WHEN cp.codigo_ultimos4 IS NOT NULL THEN '****' || cp.codigo_ultimos4
                    ELSE NULL
                END
            ),
            ', ' ORDER BY vl.posicion
        ) AS codigo_vale,
        SUM(ABS(vl.total)) AS importe_descuento_vale
    FROM documento_linea vl
    LEFT JOIN cupon_promocional cp
        ON cp.id = vl.cupon_promocional_id
    LEFT JOIN promocion p
        ON p.id = cp.promocion_id
    WHERE vl.documento_id = d.id
      AND vl.tipo_linea = 'PROMOTIONAL_COUPON'
) vale ON TRUE
WHERE dl.documento_id = CAST($P{DOCUMENTO_ID} AS uuid)
  AND dl.tipo_linea NOT IN ('MANUAL_DISCOUNT', 'PROMOTIONAL_COUPON')
ORDER BY dl.posicion]]></query>
