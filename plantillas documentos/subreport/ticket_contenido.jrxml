<jasperReport name="ticket_contenido" language="java" columnCount="1" pageWidth="207" pageHeight="842" orientation="Landscape" columnWidth="207" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="17bed20d-738b-47e9-ae3e-b13e83bc464f">
