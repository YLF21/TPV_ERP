	<parameter name="TIENDA_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["13b6fb74-3de0-3198-8166-cf4eeb249f7f"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOCUMENTO_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["58109209-2548-4c19-9c4e-6f47c541035b"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT
	    CASE
	        WHEN COALESCE(cdi.mostrar_nombre_tienda, TRUE)
	            THEN COALESCE(NULLIF(TRIM(t.nombre), ''), NULLIF(TRIM(e.razon_social), ''))
	        ELSE COALESCE(NULLIF(TRIM(e.razon_social), ''), NULLIF(TRIM(t.nombre), ''))
	    END AS nombre_cabecera,
	    CASE
	        WHEN COALESCE(cdi.mostrar_nombre_tienda, TRUE)
	            THEN NULLIF(TRIM(e.razon_social), '')
	        ELSE NULL
	    END AS nombre_empresa_secundario,

    t.nombre AS tienda,
    t.codigo_tienda,
    t.telefono,
    t.email,

    jsonb_extract_path_text(t.direccion, 'linea1') AS direccion,
    jsonb_extract_path_text(t.direccion, 'codigoPostal') AS codigo_postal,
    jsonb_extract_path_text(t.direccion, 'ciudad') AS ciudad,
    jsonb_extract_path_text(t.direccion, 'provincia') AS provincia,
    jsonb_extract_path_text(t.direccion, 'pais') AS pais,

    e.tax_id AS cif,
    e.razon_social,

    jsonb_extract_path_text(
        e.domicilio_fiscal,
        'linea1'
    ) AS direccion_fiscal,

    jsonb_extract_path_text(
        e.domicilio_fiscal,
        'codigoPostal'
    ) AS codigo_postal_fiscal,

    jsonb_extract_path_text(
        e.domicilio_fiscal,
        'ciudad'
    ) AS ciudad_fiscal,

    jsonb_extract_path_text(
        e.domicilio_fiscal,
        'provincia'
    ) AS provincia_fiscal,

    jsonb_extract_path_text(
        e.domicilio_fiscal,
        'pais'
    ) AS pais_fiscal,

    d.numero AS numero_ticket,
    COALESCE(d.confirmado_en, d.creado_en) AS fecha_ticket,
    ldt.contenido AS logo_contenido

FROM tienda t

INNER JOIN empresa e
    ON e.id = t.empresa_id

INNER JOIN documento d
    ON d.tienda_id = t.id

LEFT JOIN configuracion_documento_impreso_tienda cdi
    ON cdi.tienda_id = t.id

LEFT JOIN logo_documento_tienda ldt
    ON ldt.id = cdi.logo_id
   AND ldt.tienda_id = t.id

WHERE t.id = CAST($P{TIENDA_ID} AS uuid)
  AND d.id = CAST($P{DOCUMENTO_ID} AS uuid)]]></query>
