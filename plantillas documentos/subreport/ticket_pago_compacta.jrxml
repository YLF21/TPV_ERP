		</band>
		<band height="13">
			<printWhenExpression><![CDATA[java.lang.Boolean.TRUE.equals($F{es_metalico}) && $F{cambio} != null]]></printWhenExpression>
			<element kind="staticText" uuid="b626604c-7c5c-46c7-a203-6a9c2360afe8" x="5" y="0" width="120" height="12" fontSize="8.0"><text><![CDATA[Cambio entregado]]></text></element>
			<element kind="textField" uuid="50465408-5831-4df0-9efe-c3f57ce78974" x="130" y="0" width="70" height="12" fontSize="8.0" hTextAlign="Right"><expression><![CDATA[new java.text.DecimalFormat("#,##0.00").format($F{cambio}) + " €"]]></expression></element>
		</band>
	</detail>
</jasperReport>
