	<query language="sql"><![CDATA[SELECT
    1 AS dummy,
    d.cliente_id IS NOT NULL AS tiene_cliente,
    EXISTS (SELECT 1 FROM documento_pago dp WHERE dp.documento_id = d.id) AS tiene_pago
FROM documento d
WHERE d.id = CAST($P{DOCUMENTO_ID} AS uuid)]]></query>
