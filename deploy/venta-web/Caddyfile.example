# Dedicated Venta origin, separate from marketing and internal SaaS.
# Configure VENTA_HOST, VENTA_WEB_ROOT and VENTA_BACKEND in Caddy's environment.
# VENTA_WEB_ROOT points to frontend/apps/app-venta/dist-web (absolute path).
{$VENTA_HOST} {
    encode zstd gzip
    header {
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    route {
        @terminalBody path /api/v1/web-terminal/*
        request_body @terminalBody {
            max_size 16KB
        }
        @browserTerminal path /api/v1/web-terminal/*
        request_body @browserTerminal {
            max_size 16KB
        }
        # This public host is not an installation/bootstrap administration host.
        @privateSetup path /api/v1/terminal-linking/* /api/v1/terminals/workstations/server/adopt /api/v1/server-transfer/* /api/v1/auth/installation-login /api/v1/auth/installation-password /api/v1/installation/* /api/v1/terminals/request /api/v1/terminals/pda/* /api/v1/licenses/link-saas/bootstrap-initial /actuator/* /swagger-ui* /v3/api-docs*
        respond @privateSetup 404
        handle /api/v1/* {
            header Cache-Control "no-store"
            # Preserve the browser Origin. Do not replace it with backend origin.
            reverse_proxy {$VENTA_BACKEND:127.0.0.1:8080}
        }
        handle /assets/* {
            root * {$VENTA_WEB_ROOT}
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle {
            root * {$VENTA_WEB_ROOT}
            header Cache-Control "no-store"
            try_files {path} /index.html
            file_server
        }
    }
}
